generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String

  // ИП реквизиты
  fullName     String?
  iin          String?
  bankName     String?
  iban         String?
  bik          String?
  kbe          String?
  address      String?
  directorName String?
  phone        String?

  isProfileComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  clients      Client[]
  documents    Document[]
  subscription Subscription?
  payments     Payment[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id           String  @id @default(uuid())
  userId       String

  name         String
  bin          String
  bankName     String?
  iban         String?
  bik          String?
  kbe          String?
  address      String?
  directorName String?
  phone        String?
  email        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id       String @id @default(uuid())
  userId   String
  clientId String

  type   DocumentType
  number Int

  serviceName String
  unit        String  @default("услуга")
  quantity    Decimal @default(1)
  price       Decimal
  total       Decimal

  contractNumber String?
  contractDate   DateTime?

  date   DateTime @default(now())
  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])
  items  DocumentItem[]

  @@unique([userId, type, number])
}

model DocumentItem {
  id         String @id @default(uuid())
  documentId String

  name     String
  unit     String  @default("услуга")
  quantity Decimal @default(1)
  price    Decimal
  total    Decimal

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  INVOICE
  AVR
  ESF
}

// ==================== ПОДПИСКИ И ОПЛАТА ====================

model Subscription {
  id     String @id @default(uuid())
  userId String

  plan      PlanType @default(FREE)
  status    SubStatus @default(ACTIVE)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([userId])
}

model Payment {
  id             String @id @default(uuid())
  subscriptionId String
  userId         String

  amount    Decimal
  currency  String  @default("KZT")
  method    String  @default("kaspi") // kaspi, card, manual
  status    PaymentStatus @default(PENDING)

  // Kaspi Pay данные
  kaspiOrderId  String?  @unique
  kaspiTxnId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanType {
  FREE
  PRO
  PRO_ACCOUNTANT
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
